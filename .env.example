# ==========================================
# AI Resume Analyzer Pro - Environment Config
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection URI (Local or MongoDB Atlas)
# If left empty or MongoDB is not running locally, the server seamlessly activates
# the zero-setup in-memory adaptive store for immediate local development.
MONGODB_URI=mongodb://127.0.0.1:27017/resume_analyzer_pro

# Security & Authentication
# Strong secret key for signing JSON Web Tokens
JWT_SECRET=dev_secret_placement_key_replace_in_production_2026

# Frontend Client URL for CORS Whitelisting
CLIENT_URL=http://localhost:5173

# Optional Configurable AI Integration
# Leave blank to use the high-performance rule-based heuristic engineering engine.
# Provide a Google Gemini API key to activate generative LLM suggestions.
GEMINI_API_KEY=
